# CampusNest server — environment template.
# Copy to `.env` and fill in real values. Never commit the filled-in file.
#
# NOTE: CONVEX_URL, CONVEX_DEPLOYMENT and CONVEX_SITE_URL are normally
# written automatically into `.env.local` by `npx convex dev` — that is the
# file the Convex CLI owns and keeps rewriting. They are listed here only so
# the full set of variables the server reads is documented in one place.

# Convex deployment the backend talks to, e.g. https://happy-animal-123.convex.cloud
CONVEX_URL=
# Convex deployment identifier, e.g. dev:happy-animal-123 (the seed script
# refuses to run unless this is a dev: deployment matching CONVEX_URL)
CONVEX_DEPLOYMENT=

# Shared secret gating EVERY Convex function (see convex/lib/secureFunction.ts).
# Must be set identically on the deployment (`npx convex env set
# CONVEX_ADAPTER_SECRET ...`) and here. Treat as a datastore root credential.
CONVEX_ADAPTER_SECRET=

# better-auth signing secret (long random string)
BETTER_AUTH_SECRET=
# Public base URL better-auth issues links and cookies against
BETTER_AUTH_URL=http://localhost:5000

# Comma-separated origins allowed by CORS, e.g. http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Port the Express server listens on
PORT=5000
# development | production
NODE_ENV=development
# Only sign-ups from this email domain are accepted, e.g. st.ug.edu.gh
ALLOWED_EMAIL_DOMAIN=

# External 360-degree panorama/tour service used by the room tour endpoints
PANO_API_URL=
PANO_API_KEY=

# Microsoft Entra ID (Azure AD) OAuth application credentials
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
